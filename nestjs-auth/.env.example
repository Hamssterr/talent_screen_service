# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
SWAGGER_ENABLED=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_auth

# JWT Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@talentscreen.com

# Redis & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Document Storage
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_LOCAL_ROOT=./data/private-documents
CV_MAX_FILE_SIZE_BYTES=10485760

# Cloudinary (Bắt buộc khi DOCUMENT_STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=talent-screen/cv

# AI Integration (Optional for MVP)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Initial Admin Bootstrap (Chỉ dùng tạm khi chạy `npm run authz:bootstrap-admin` lần đầu)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator

# Notifications (Encryption for temporary invitation payloads)
NOTIFICATION_PAYLOAD_CRYPTO_KEY=replace-with-a-long-random-secret-at-least-32-chars
NOTIFICATION_PAYLOAD_TTL_MINUTES=10080
