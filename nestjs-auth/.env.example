# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=true

# Database (PostgreSQL Neon / Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_auth

# JWT Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-secret-for-refresh-token
JWT_REFRESH_EXPIRES_IN=7d

# Email Provider ('local' cho dev/mock, 'smtp' hoặc 'nodemailer' cho gửi email thật qua Gmail / SMTP)
EMAIL_PROVIDER=local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_16_digits
EMAIL_FROM=Talent Screen <your_email@gmail.com>
EMAIL_TIMEOUT_MS=10000

# Document Storage
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_LOCAL_ROOT=./data/private-documents
CV_MAX_FILE_SIZE_BYTES=10485760

# Cloudinary (Bắt buộc khi DOCUMENT_STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=talent-screen/cv

# AI Integration (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROFILE_TIMEOUT_MS=30000
AI_QUESTION_TIMEOUT_MS=30000
AI_FOLLOW_UP_TIMEOUT_MS=15000
AI_FOLLOW_UP_MIN_REMAINING_MS=20000
AI_FOLLOW_UP_RECOVERY_GRACE_MS=5000
AI_SUMMARY_TIMEOUT_MS=30000
CV_EXTRACTION_MAX_PAGES=20
CV_EXTRACTION_MAX_TEXT_CHARS=50000
AI_PROCESSING_STALE_MS=120000

# Initial Admin Bootstrap (Chỉ dùng tạm khi chạy `npm run authz:bootstrap-admin` lần đầu)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator

# Notifications (Encryption for temporary invitation payloads)
NOTIFICATION_PAYLOAD_CRYPTO_KEY=replace-with-a-long-random-secret-at-least-32-chars
NOTIFICATION_PAYLOAD_TTL_MINUTES=10080
NOTIFICATION_SENDING_STALE_MS=120000

